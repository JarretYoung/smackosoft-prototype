# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key

# Backend database connection. Role: smackosoft_service. Local Supabase Postgres port is 54322.
DATABASE_URL=postgres://smackosoft_service:CHANGE_ME@127.0.0.1:54322/postgres
